<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <!--
      Grpc.Tools ships protoc + the MSBuild integration that compiles .proto
      files to C# at build time. PrivateAssets="All" keeps it from leaking into
      downstream projects (they only need Google.Protobuf at runtime).
    -->
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GrpcServices="None" → generate message classes only, no gRPC service stubs.
      Access="Public"     → generated classes are public (default is internal).
    -->
    <Protobuf Include="Protos\*.proto" GrpcServices="None" Access="Public" />
  </ItemGroup>

</Project>
